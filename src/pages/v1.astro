 </a>
 <a href="https://facebook.com/pizzaplusfriends" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
 <svg focusable="false" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
 </a>
 <a href="https://linkedin.com/company/pizzaplusfriends" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
 <svg focusable="false" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
 </a>
 </div>
 </div>
 </div>

 <!-- Activity Slides -->
 {ACTIVITIES.map((activity, i) => (
 <div class="slide" id={`slide-${i + 1}`} style="display: none;">
 <div class="activity-slide">
 <div class="activity-image-wrap">
 {activity.image ? (
 <img
 src={activity.image}
 alt={activity.title}
 width="280"
 height="280"
 class="activity-image"
 loading="lazy"
 />
 ) : activity.video ? (
 <video
 tabindex="-1"
 src={activity.video}
 width="280"
 height="280"
 class="activity-image"
 autoplay
 loop
 muted
 playsinline
 aria-label={activity.title}
 >
 {activity.captions && (
 <track kind="captions" src={activity.captions} srclang="en" label="English" default />
 )}
 </video>
 ) : null}
 </div>
 <h2 class="activity-title">{activity.title}</h2>
 <span class="activity-date">{activity.date}</span>
 <div class="activity-desc-box">
 <p class="activity-desc">{activity.description}</p>
 </div>
 </div>
 </div>
 ))}
 </div>

 <!-- Dots indicator -->
 <div class="dots">
 <span class="dot dot-active" id="dot-0"></span>
 {ACTIVITIES.map((_, i) => (
 <span class="dot" id={`dot-${i + 1}`}></span>
 ))}
 </div>

 <div style="margin-top: 4rem;">
 <a href="/archive" style="background: var(--light-gray); color: var(--dark); padding: 0.6rem 1.2rem; border-radius: 100px; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;" onmouseover="this.style.background='#d8ccc3'" onmouseout="this.style.background='var(--light-gray)'">&larr; Back to Archive</a>
 </div>
 </main>
</Layout>

<style>
 /* ─── VIEWPORT CENTER ─── */
.viewport-center {
 width: 100%;
 min-height: 100vh;
 display: flex;
 flex-direction: column;
 align-items: center;
 justify-content: center;
 text-align: center;
 padding: 2rem;
 position: relative;
 }

 /* ─── PIZZA BUTTON ─── */
.pizza-button {
 background: none;
 border: none;
 cursor: pointer;
 position: relative;
 display: inline-flex;
 flex-direction: column;
 align-items: center;
 margin-bottom: 1.5rem;
 z-index: 10;
 transition: transform 0.2s;
 }

.pizza-button:hover {
 transform: scale(1.1);
 }

.pizza-button:hover.pizza-hint {
 opacity: 1;
 transform: translateY(0);
 }

.pizza-hint {
 font-size: 0.75rem;
 color: var(--red);
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 opacity: 0.6; /* override: always show hint initially */
 transform: translateY(4px);
 transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
 margin-top: 0.4rem;
 white-space: nowrap;
 animation: hint-pulse 2.5s ease-in-out infinite;
 }

 @keyframes hint-pulse {
 0%, 100% { opacity: 0.6; }
 50% { opacity: 1; }
 }

 /* ─── HERO ─── */
.hero-pizza {
 width: 120px;
 height: 120px;
 margin-bottom: 1.5rem;
 filter: drop-shadow(0 8px 24px rgba(242, 70, 56, 0.18));
 animation: float 4s ease-in-out infinite;
 }

 @keyframes float {
 0%, 100% { transform: translateY(0) rotate(0deg); }
 50% { transform: translateY(-12px) rotate(3deg); }
 }

 /* ─── GIANT TEXT ─── */
.hero-title {
 position: relative;
 z-index: 4;
 width: 100%;
 text-align: center;
 margin-bottom: 1.5rem;
 }

.hero-title-text {
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 color: var(--dark);
 line-height: 1;
 letter-spacing: -0.03em;
 white-space: nowrap;
 font-size: clamp(3.5rem, 10vw, 9rem);
 }

 /* ─── TYPED WORD ─── */
.typed-word {
 color: var(--red);
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 position: relative;
 display: inline;
 }

.cursor-blink {
 display: inline-block;
 width: 3px;
 background: var(--red);
 margin-left: 2px;
 animation: blink 0.7s step-end infinite;
 vertical-align: baseline;
 height: 0.75em;
 }

 @keyframes blink {
 50% {
 opacity: 0;
 }
 }

 /* ─── TAGLINE ─── */
.hero-tagline {
 font-size: 1.15rem;
 color: var(--gray);
 max-width: 480px;
 line-height: 1.7;
 margin: 0 auto 2.5rem;
 }

 /* ─── CTA ─── */
.cta-row {
 display: flex;
 gap: 1rem;
 align-items: center;
 justify-content: center;
 flex-wrap: wrap;
 }

.cta-primary {
 display: inline-flex;
 align-items: center;
 gap: 0.5rem;
 padding: 0.85rem 2rem;
 background: var(--red);
 color: var(--white);
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 font-size: 0.95rem;
 border: none;
 border-radius: 100px;
 text-decoration: none;
 cursor: pointer;
 transition: background-color 0.25s cubic-bezier(0.22, 1, 0.36, 1);
 box-shadow: 0 4px 16px rgba(242, 70, 56, 0.25);
}

.cta-primary:hover {
 background: #d93a2e;
}

 /* ─── SOCIAL ICONS ─── */
.social-icons {
 display: flex;
 gap: 1rem;
 align-items: center;
 }

.social-icons a {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 width: 40px;
 height: 40px;
 border-radius: 50%;
 border: 1.5px solid var(--light-gray);
 color: var(--dark);
 transition: border-color 0.25s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

.social-icons a:hover {
 border-color: var(--red);
 color: var(--red);
}

 /* ─── SLIDE CONTAINER ─── */
.slide-container {
 width: 100%;
 max-width: 600px;
 overflow: hidden;
 position: relative;
 }

.slide {
 transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
 transform: translateX(0);
 opacity: 1;
 }

.slide-exit-left {
 transform: translateX(-120%);
 opacity: 0;
 }

.slide-enter-right {
 transform: translateX(120%);
 opacity: 0;
 transition: none;
 }

 /* ─── ACTIVITY SLIDE ─── */
.activity-slide {
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 1rem;
 padding: 1rem 0;
 }

.activity-image-wrap {
 height: 240px;
 border-radius: 20px;
 overflow: hidden;
 background: var(--off-white);
 display: flex;
 align-items: center;
 justify-content: center;
 border: 2px solid var(--light-gray);
 }

.activity-image {
 height: 100%;
 width: auto;
 object-fit: contain;
 }

.activity-title {
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 font-size: 1.5rem;
 color: var(--dark);
 margin: 0;
 }

.activity-desc {
 font-size: 1rem;
 color: var(--gray);
 max-width: 400px;
 line-height: 1.7;
 margin: 0;
 }

.activity-date {
 font-size: 0.85rem;
 color: var(--red);
 font-family: 'Libre Baskerville', serif;
 font-weight: 700;
 letter-spacing: 0.02em;
 }

.activity-desc-box {
 height: 5.1em;
 overflow: hidden;
 display: flex;
 align-items: flex-start;
 justify-content: center;
 }

 /* ─── DOTS INDICATOR ─── */
.dots {
 display: flex;
 gap: 0.5rem;
 margin-top: 2rem;
 }

.dot {
 width: 8px;
 height: 8px;
 border-radius: 50%;
 background: var(--light-gray);
 transition: background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.dot-active {
 background: var(--red);
 transform: scale(1.3);
 }

 /* ─── RESPONSIVE ─── */
 @media (max-width: 768px) {
.hero-pizza {
 width: 80px;
 height: 80px;
 }

.hero-title-text {
 white-space: normal;
 }

.activity-image-wrap {
 width: 160px;
 height: 160px;
 }
 }
</style>

<script>
 // --- TypeWriter Logic ---
 const words = ["pizza", "friends"];
 let wordIndex = 0;
 let text = "";
 let isDeleting = false;
 let typeSpeed = 130;
 let deleteSpeed = 70;
 
 function type() {
 const el = document.getElementById("type-text");
 if (!el) return;
 
 const currentWord = words[wordIndex];
 if (isDeleting) {
 text = currentWord.substring(0, text.length - 1);
 } else {
 text = currentWord.substring(0, text.length + 1);
 }
 
 el.textContent = text;
 
 let speed = isDeleting ? deleteSpeed : typeSpeed;
 
 if (!isDeleting && text === currentWord) {
 speed = 2200;
 isDeleting = true;
 } else if (isDeleting && text === "") {
 isDeleting = false;
 wordIndex = (wordIndex + 1) % words.length;
 speed = 350;
 }
 
 setTimeout(type, speed);
 }
 
 // Start the typing animation
 setTimeout(type, typeSpeed);

 // --- Slider Logic ---
 const slides = document.querySelectorAll('.slide');
 const dots = document.querySelectorAll('.dot');
 let currentIndex = 0;
 const totalSlides = slides.length;
 let isAnimating = false;
 
 document.getElementById('next-btn').addEventListener('click', () => {
 if (isAnimating) return;
 isAnimating = true;

 const currentSlide = slides[currentIndex];
 currentSlide.className = 'slide slide-exit-left';
 
 setTimeout(() => {
 currentSlide.style.display = 'none';
 dots[currentIndex].classList.remove('dot-active');
 
 currentIndex = (currentIndex + 1) % totalSlides;
 
 const nextSlide = slides[currentIndex];
 nextSlide.className = 'slide slide-enter-right';
 nextSlide.style.display = 'block';
 dots[currentIndex].classList.add('dot-active');
 
 // Force reflow
 void nextSlide.offsetHeight;
 
 setTimeout(() => {
 nextSlide.className = 'slide';
 setTimeout(() => {
 isAnimating = false;
 }, 400); // Wait for transition to finish before allowing another click
 }, 50);
 
 }, 400);
 });
</script>
